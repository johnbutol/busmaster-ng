// Resources of the Instruments plugin of BUSMASTER-NG
#include "resource.h"
#include "afxres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_INSTRUMENTS         ICON                    "res\\Instruments.ico"

IDD_SELECT_VARIABLE DIALOGEX 0, 0, 320, 282
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose a Signal"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Search:",IDC_STATIC,7,10,30,8
    EDITTEXT        IDC_FILTER,40,7,273,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_TREE,"SysTreeView32",TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,26,306,204
    LTEXT           "",IDC_INFO,7,235,306,18
    PUSHBUTTON      "&No Signal",IDC_CLEAR,7,261,60,14
    DEFPUSHBUTTON   "OK",IDOK,199,261,55,14
    PUSHBUTTON      "Cancel",IDCANCEL,258,261,55,14
END

// The version resource is added to every project by Sources\Directory.Build.targets
