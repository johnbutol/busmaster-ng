// Resources of CAN_Teensy.dll: the hardware selection dialog shared by the CAN drivers and the
// advanced settings of a channel. The version information comes from Sources\BusmasterNGVersion.rc.

// the number of the dialog (IDD_DLG_HW_LISTING_CAN), which the header of ChannelSelection.rc does not define
#include "../DIL_Interface/resource.h"
#include "../DIL_Interface/ChannelSelection.rc"

#include "CAN_Teensy_Resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_TEENSY_SETTINGS DIALOGEX 0, 0, 286, 152
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Teensy - Advanced Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_TEENSY_INTERFACE,10,9,266,10
    CONTROL         "CAN FD (ISO)",IDC_TEENSY_CANFD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,27,266,10
    LTEXT           "Data bit rate (bit/s):",IDC_TEENSY_DATA_RATE_LABEL,22,44,80,10
    COMBOBOX        IDC_TEENSY_DATA_RATE,104,42,70,120,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "The bit rate in the list of channels is the one of the arbitration phase. CAN FD frames are sent with bit rate switch when the data bit rate is higher.",IDC_TEENSY_NOTE,22,59,254,26
    CONTROL         "Self test: loop the frames inside the controller, nothing is sent to the bus",IDC_TEENSY_SELF_TEST,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,93,266,10
    LTEXT           "With the self test every frame sent on this channel is also received on it. The channel does not see the bus.",-1,22,106,254,18
    DEFPUSHBUTTON   "OK",IDOK,172,131,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,226,131,50,14
END
