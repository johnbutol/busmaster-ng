// Resources of Ethernet.dll
//
#include "Ethernet_Resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

IDI_ETHERNET            ICON                    "res/Ethernet.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ETH_MSG DIALOGEX 0, 0, 600, 300
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "",IDC_ETH_STATUS,7,7,586,8,SS_ENDELLIPSIS
    CONTROL         "",IDC_ETH_FRAMES,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | LVS_OWNERDATA | WS_BORDER | WS_TABSTOP,7,18,586,275
END

IDD_ETH_TX DIALOGEX 0, 0, 520, 268
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    CONTROL         "",IDC_ETH_TX_LIST,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,7,7,506,128
    LTEXT           "Name:",IDC_STATIC,7,144,58,8
    EDITTEXT        IDC_ETH_TX_NAME,68,142,96,12,ES_AUTOHSCROLL
    LTEXT           "Type:",IDC_STATIC,172,144,22,8
    COMBOBOX        IDC_ETH_TX_KIND,196,142,96,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Cycle (ms):",IDC_STATIC,300,144,40,8
    EDITTEXT        IDC_ETH_TX_CYCLE,342,142,36,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Destination MAC:",IDC_STATIC,7,162,58,8
    EDITTEXT        IDC_ETH_TX_DST,68,160,80,12,ES_AUTOHSCROLL
    LTEXT           "Source MAC:",IDC_STATIC,156,162,44,8
    EDITTEXT        IDC_ETH_TX_SRC,202,160,80,12,ES_AUTOHSCROLL
    LTEXT           "VLAN ID:",IDC_STATIC,290,162,32,8
    EDITTEXT        IDC_ETH_TX_VLAN,324,160,30,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Priority:",IDC_STATIC,362,162,30,8
    EDITTEXT        IDC_ETH_TX_PRIO,394,160,20,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "EtherType:",IDC_STATIC,7,180,58,8
    EDITTEXT        IDC_ETH_TX_ETHERTYPE,68,178,40,12,ES_AUTOHSCROLL
    LTEXT           "Source IP:",IDC_STATIC,116,180,36,8
    EDITTEXT        IDC_ETH_TX_SRCIP,154,178,64,12,ES_AUTOHSCROLL
    LTEXT           "Port:",IDC_STATIC,222,180,18,8
    EDITTEXT        IDC_ETH_TX_SRCPORT,242,178,30,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Destination IP:",IDC_STATIC,280,180,52,8
    EDITTEXT        IDC_ETH_TX_DSTIP,334,178,64,12,ES_AUTOHSCROLL
    LTEXT           "Port:",IDC_STATIC,402,180,18,8
    EDITTEXT        IDC_ETH_TX_DSTPORT,422,178,30,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Data (hex):",IDC_STATIC,7,198,58,8
    EDITTEXT        IDC_ETH_TX_DATA,68,196,445,30,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    PUSHBUTTON      "&Add",IDC_ETH_TX_ADD,68,232,50,14
    PUSHBUTTON      "&Update",IDC_ETH_TX_UPDATE,122,232,50,14
    PUSHBUTTON      "&Delete",IDC_ETH_TX_DELETE,176,232,50,14
    PUSHBUTTON      "&Send",IDC_ETH_TX_SEND,236,232,50,14
    LTEXT           "",IDC_ETH_TX_STATUS,294,235,219,8,SS_ENDELLIPSIS
    LTEXT           "Empty source MAC or IP: those of the adapter. Empty VLAN ID: no VLAN tag. Checked frames are sent every cycle while connected.",IDC_ETH_TX_HINT,7,252,506,8,SS_ENDELLIPSIS
END

IDD_ETH_ADAPTER DIALOGEX 0, 0, 420, 222
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ethernet Adapter"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Network adapter:",IDC_ETH_ADAPTERS_LABEL,7,7,200,8
    CONTROL         "",IDC_ETH_ADAPTERS,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,7,18,406,110
    CONTROL         "&Promiscuous mode: all the frames on the wire, not only those for this PC",IDC_ETH_PROMISC,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,134,406,10
    LTEXT           "Capture &filter, pcap syntax (for example: not tcp port 3389, ether proto 0x88f7, vlan 5); empty: all frames",IDC_ETH_FILTER_LABEL,7,150,406,8
    EDITTEXT        IDC_ETH_FILTER,7,160,406,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_ETH_PCAP_VERSION,7,180,406,8,SS_ENDELLIPSIS
    DEFPUSHBUTTON   "OK",IDOK,309,201,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,363,201,50,14
END
