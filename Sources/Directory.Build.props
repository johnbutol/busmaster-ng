<?xml version="1.0" encoding="utf-8"?>
<!--
  BUSMASTER-NG: optional build for Windows 7.

  The Windows 7 build also runs on processors without SSE2 (Pentium III, Athlon XP, some industrial PCs). The C++ /
  MFC runtime of every v14x toolset (mfc140.dll, msvcp140.dll) is built by Microsoft with SSE2 instructions that are
  used without checking the processor, so the Windows 7 build uses the Visual Studio 2013 toolset v120_xp instead,
  with /arch:SSE (Directory.Build.targets), and ships the 120 runtime (msvcr120, msvcp120, mfc120) next to the exe.

  Default build (Windows 10 or later): nothing changes, the newest installed v143 toolset is used.

  Windows 7 build:  MSBuild ... /p:BusmasterWin7=true
  Requires Visual Studio 2013 (or its C++ build tools) with the MFC MBCS library, installed beside Visual Studio 2022.

  Note: the output goes to the same BIN\Release folder as the default build, so do a clean build
  before packaging a Windows 7 version.
-->
<Project>
  <PropertyGroup Condition="'$(BusmasterWin7)' == 'true'">
    <ForceImportBeforeCppProps>$(MSBuildThisFileDirectory)BusmasterWin7.props</ForceImportBeforeCppProps>
  </PropertyGroup>

  <!--
    Installing an older MSVC component (such as 14.38) makes the Visual Studio installer rewrite
    Microsoft.VCToolsVersion.v143.default.props to that older version, which would silently turn the default build
    into a 14.38 build. For the default build, take the toolset that Visual Studio itself marks as default
    (Microsoft.VCToolsVersion.default.txt) instead.
  -->
  <PropertyGroup Condition="'$(BusmasterWin7)' != 'true' And '$(VCToolsVersion)' == ''">
    <BusmasterVsDefaultToolsFile>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)\..\..\..\VC\Auxiliary\Build\Microsoft.VCToolsVersion.default.txt'))</BusmasterVsDefaultToolsFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BusmasterVsDefaultToolsFile)' != '' And Exists('$(BusmasterVsDefaultToolsFile)')">
    <VCToolsVersion>$([System.IO.File]::ReadAllText('$(BusmasterVsDefaultToolsFile)').Trim())</VCToolsVersion>
  </PropertyGroup>
</Project>
